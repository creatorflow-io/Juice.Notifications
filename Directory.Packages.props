<Project>
  <ItemGroup>
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- The same Juice versions as Juice.Observability, the first producer (phase-1-plan I1). Ahead of it (10.12.0) at 10.13.1: the commit-failure fix and the RabbitMQ consumer fixes (docs/deferred.md #2, #17-#19, #21). -->
    <PackageVersion Include="JsonSchema.Net" Version="9.5.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- The sample producer's event listener (the version Juice.EventBus.RabbitMQ brings). -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
    <!-- Audit records to services/audit (p1-09): UseAudit() and the gRPC client. Built against Juice 10.10, which 10.13 satisfies. -->
    <PackageVersion Include="Juice.Audit.Api" Version="10.6.1" />
    <PackageVersion Include="Juice.EF" Version="10.13.1" />
    <PackageVersion Include="Juice.EventBus.RabbitMQ" Version="10.13.1" />
    <PackageVersion Include="Juice.MediatR" Version="10.13.1" />
    <PackageVersion Include="Juice.MediatR.Behaviors" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Idempotency.Caching" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Local" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Outbox.Delivery" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Outbox.EF" Version="10.13.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="Scriban" Version="7.2.5" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
