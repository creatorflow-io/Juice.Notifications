{
  "stryker-config": {
    "project": "Juice.Notifications.csproj",
    "test-projects": [
      "../../test/Juice.Notifications.Tests/Juice.Notifications.Tests.csproj",
      "../../test/Juice.Notifications.IntegrationTests/Juice.Notifications.IntegrationTests.csproj"
    ],
    "mutate": [
      "**/Delivering/DeliveryPlanner.cs",
      "**/Intake/Intake.cs"
    ],
    "test-runner": "mtp",
    "test-case-filter": "FullyQualifiedName!~CrashTests&FullyQualifiedName!~LoadCheckTests",
    "reporters": ["json", "html", "progress"],
    "concurrency": 4,
    "additional-timeout": 30000,
    "thresholds": { "high": 80, "low": 60, "break": 0 }
  }
}
