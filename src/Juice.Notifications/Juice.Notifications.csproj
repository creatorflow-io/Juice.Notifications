<Project Sdk="Microsoft.NET.Sdk">

  <!-- The service's behavior: commands, stages and rules. Host-agnostic, so a product can embed it (design D2). -->
  <ItemGroup>
    <PackageReference Include="Juice.MediatR" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="MailKit" />
    <!-- The outbox and its local route (Hosting/Pipeline.cs): both hosting modes run them. -->
    <PackageReference Include="Juice.Messaging.Outbox.Delivery" />
    <PackageReference Include="Juice.Messaging.Local" />
    <PackageReference Include="Juice.Messaging.Idempotency.Caching" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Notifications.EF\Juice.Notifications.EF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The request rules are tested directly (RequestRulesTests): the HTTP tests can't reach every limit and branch at a useful cost. -->
    <InternalsVisibleTo Include="Juice.Notifications.Tests" />
    <InternalsVisibleTo Include="Juice.Notifications.IntegrationTests" />
  </ItemGroup>

</Project>
