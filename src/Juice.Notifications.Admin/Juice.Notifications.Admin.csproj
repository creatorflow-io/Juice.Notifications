<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tenant-admin API (phase 5, M44-3): mapped by the service under /api/v1, or by a host that embeds the pipeline under its own prefix and
       its own authentication. ASP.NET Core only: no JwtBearer, SignalR, Juice.Audit or Juice.MultiTenant (m44-architecture §3.4). -->
  <PropertyGroup>
    <Description>Juice Notifications admin API: the tenant-admin endpoints, for the service or a host that embeds the pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Notifications\Juice.Notifications.csproj" />
    <ProjectReference Include="..\Juice.Notifications.Api.Contracts\Juice.Notifications.Api.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Notifications.Api" />
    <InternalsVisibleTo Include="Juice.Notifications.Tests" />
    <InternalsVisibleTo Include="Juice.Notifications.IntegrationTests" />
  </ItemGroup>

</Project>
