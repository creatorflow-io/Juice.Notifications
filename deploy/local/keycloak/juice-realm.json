{
  "realm": "juice",
  "enabled": true,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      { "name": "notifications-platform-admin", "description": "Registers applications and links them to tenants" },
      { "name": "notifications-tenant-admin", "description": "Administers the notifications of the one tenant its token's platform_tenant claim names" },
      { "name": "on-call", "description": "People on call (local identity directory)" }
    ]
  },
  "groups": [{ "name": "ops", "path": "/ops" }],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"platform_tenant\",\"displayName\":\"Platform tenant\",\"validations\":{\"length\":{\"max\":36}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "juice-notifications",
      "description": "The Juice.Notifications API: its audience, realm roles as a flat 'roles' claim, and client_id on service-account (client credentials) tokens only",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "juice-notifications", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "client id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": { "user.session.note": "client_id", "claim.name": "client_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "notifications-admin",
      "name": "Platform admin (local)",
      "enabled": true,
      "publicClient": false,
      "secret": "${NOTIFICATIONS_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["juice-notifications"]
    },
    {
      "clientId": "sample-producer",
      "name": "Sample producer (local)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SAMPLE_PRODUCER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["juice-notifications"]
    },
    {
      "clientId": "tenant-admin",
      "name": "Tenant admin (local): administers tenant 0193f0aa-0000-7000-8000-0000000000a1, the integration tests' tenant",
      "enabled": true,
      "publicClient": false,
      "secret": "${TENANT_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["juice-notifications"],
      "protocolMappers": [
        {
          "name": "platform tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "platform_tenant", "claim.value": "0193f0aa-0000-7000-8000-0000000000a1", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "people-test",
      "name": "People (local): signs in the realm's person accounts with a password, for the person's API tests; each person's tenant is their platform_tenant attribute",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["juice-notifications"],
      "protocolMappers": [
        {
          "name": "platform tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "platform_tenant", "claim.name": "platform_tenant", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "juice-layout-demo",
      "name": "juice-layout demo app (local): signs people in with the code flow for @juice-js/notifications' bell and settings pages",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://localhost:4201/*"],
      "webOrigins": ["https://localhost:4201"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://localhost:4201/*" },
      "defaultClientScopes": ["juice-notifications"],
      "protocolMappers": [
        {
          "name": "platform tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "platform_tenant", "claim.name": "platform_tenant", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": { "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "notifications-directory",
      "name": "Notifications identity directory (local): reads users, groups and realm roles for the identity resolver",
      "enabled": true,
      "publicClient": false,
      "secret": "${NOTIFICATIONS_DIRECTORY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-notifications-admin",
      "enabled": true,
      "serviceAccountClientId": "notifications-admin",
      "realmRoles": ["notifications-platform-admin"]
    },
    {
      "username": "service-account-sample-producer",
      "enabled": true,
      "serviceAccountClientId": "sample-producer",
      "realmRoles": []
    },
    {
      "username": "service-account-tenant-admin",
      "enabled": true,
      "serviceAccountClientId": "tenant-admin",
      "realmRoles": ["notifications-tenant-admin"]
    },
    {
      "username": "service-account-notifications-directory",
      "enabled": true,
      "serviceAccountClientId": "notifications-directory",
      "realmRoles": [],
      "clientRoles": { "realm-management": ["view-users", "view-realm"] }
    },
    {
      "username": "ann",
      "enabled": true,
      "email": "ann@example.com",
      "emailVerified": true,
      "firstName": "Ann",
      "lastName": "Local",
      "attributes": { "platform_tenant": ["0193f0aa-0000-7000-8000-0000000000a1"] },
      "credentials": [{ "type": "password", "value": "${PEOPLE_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": [],
      "groups": ["/ops"]
    },
    {
      "username": "ben",
      "enabled": true,
      "email": "ben@example.com",
      "emailVerified": true,
      "firstName": "Ben",
      "lastName": "Local",
      "attributes": { "platform_tenant": ["0193f0aa-0000-7000-8000-0000000000a1"] },
      "credentials": [{ "type": "password", "value": "${PEOPLE_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": ["on-call"]
    },
    {
      "username": "dora",
      "enabled": true,
      "email": "dora@example.com",
      "emailVerified": false,
      "firstName": "Dora",
      "lastName": "Local",
      "attributes": { "platform_tenant": ["0193f0aa-0000-7000-8000-0000000000a1"] },
      "credentials": [{ "type": "password", "value": "${PEOPLE_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": [],
      "groups": ["/ops"]
    },
    {
      "username": "eli",
      "enabled": false,
      "email": "eli@example.com",
      "emailVerified": true,
      "firstName": "Eli",
      "lastName": "Local",
      "attributes": { "platform_tenant": ["0193f0aa-0000-7000-8000-0000000000a1"] },
      "credentials": [{ "type": "password", "value": "${PEOPLE_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": ["on-call"],
      "groups": ["/ops"]
    },
    {
      "username": "cara",
      "enabled": true,
      "email": "cara@example.com",
      "emailVerified": true,
      "firstName": "Cara",
      "lastName": "Local",
      "attributes": { "platform_tenant": ["0193f0aa-0000-7000-8000-0000000000b2"] },
      "credentials": [{ "type": "password", "value": "${PEOPLE_TEST_PASSWORD}", "temporary": false }],
      "realmRoles": ["on-call"],
      "groups": ["/ops"]
    }
  ]
}
